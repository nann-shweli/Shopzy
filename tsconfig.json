{
	"extends": "@react-native/typescript-config",
	"compilerOptions": {
		"target": "esnext",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"types": ["node"],
		"jsx": "react-native",
		"noEmit": true,
		"strict": true,
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"]
}
